# Environment template for the repository's compose.yaml. Copy to .env and replace
# the placeholders before use. Startup requires reviewed source packages under
# config/sources/, config/database-profiles.yaml and matching client certificates;
# this file does not register sources. See docs/operations.md for setup and startup.
# Query Cave uses its own configuration and commands: query-cave/README.md.

# Compose database settings. Database profiles own the endpoint and authentication.
# These values override a profile only when it declares
# host_env: QUERY_MAN_POSTGRES_HOST and port_env: POSTGRES_PORT, respectively.
# Otherwise the profile's literal host/port apply. Compose still requires the host variable.
QUERY_MAN_POSTGRES_HOST=replace-with-source-postgres-host
POSTGRES_PORT=5432
# Host credential root, mounted read-only at /run/secrets/query-man/databases.
# Each <database-profile-id>/ must contain ca.crt, client.crt and client.key.
# See docs/database-certificate-authentication.md for layout and file permissions.
QUERY_MAN_DATABASE_CREDENTIAL_MOUNT=/secure/query-man/databases
TZ=Asia/Seoul

# Compose uses config/access-policies.compose.yaml with separate query-only and
# operator caller tokens. Every authenticated caller sees all configured sources.
# Replace BOTH placeholders with different random tokens before starting.
# Generate each token separately with: openssl rand -hex 32
QUERY_MAN_QUERY_TOKEN=replace-with-at-least-32-random-characters
QUERY_MAN_OPERATOR_TOKEN=replace-with-a-different-32-character-random-token

# Shared application settings. In Compose, QUERY_MAN_PORT is the host loopback port;
# the container listens on port 3000. Direct execution uses it as the listen port.
QUERY_MAN_PORT=3000
QUERY_MAN_LOG_LEVEL=info
QUERY_MAN_METADATA_CACHE_TTL_MS=30000
QUERY_MAN_METADATA_MAX_STALE_MS=300000
QUERY_MAN_METADATA_RETRY_DELAY_MS=5000
# One shared graceful-work budget; the orchestrator stop grace must leave cleanup overhead.
QUERY_MAN_SHUTDOWN_GRACE_MS=10000

# Optional settings for direct execution with `uv run query-man` from the repository root.
# The server reads .env. Root Compose fixes the bind host, authentication policy and
# credential directory itself; uncommenting the options below does not change Compose.
# QUERY_MAN_HOST=127.0.0.1
# Direct execution reads certificates from this directory; it does not use the mount variable.
# QUERY_MAN_DATABASE_CREDENTIAL_DIRECTORY=/secure/query-man/databases
#
# Choose one authentication method. The two caller tokens above alone do not enable
# authentication in direct execution. Reuse the shipped version 2 policy and those tokens:
# QUERY_MAN_ACCESS_POLICY_FILE=config/access-policies.compose.yaml
# Or set a single query-only token; this method never grants operator capability:
# QUERY_MAN_API_TOKEN=replace-with-at-least-32-random-characters
# Do not enable both methods. Non-loopback binding requires one; loopback with neither
# allows anonymous queries.
