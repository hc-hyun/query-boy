POSTGRES_DB=query_man
POSTGRES_USER=query_man_admin
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432
TZ=Asia/Seoul
# Compose maps this dedicated query-only caller token into the Query Man container. Every
# authenticated caller sees all active bootstrap sources; this token has no admin capability.
# Generate a local value with: openssl rand -hex 32
QUERY_MAN_CODEX_MCP_TOKEN=replace-with-at-least-32-random-characters
DEVELOPMENT_ISSUES_READER_PASSWORD=replace-with-a-local-secret
MARKET_VOC_READER_PASSWORD=replace-with-a-local-secret
SUPPORT_TICKETS_READER_PASSWORD=replace-with-a-local-secret
COMMERCE_EDGES_READER_PASSWORD=replace-with-a-local-secret
QUERY_MAN_HOST=127.0.0.1
QUERY_MAN_PORT=3000
# Optional second loopback port used only by the Compose `soak` profile.
QUERY_MAN_REPLICA_PORT=3001
QUERY_MAN_LOG_LEVEL=info
# Source authority selector (default: `bootstrap`). Bootstrap is local/CI filesystem mode and
# forbids QUERY_MAN_CONTROL_DSN/QUERY_MAN_SOURCE_ENCRYPTION_KEY. Production explicitly uses managed.
QUERY_MAN_SOURCE_MODE=bootstrap
# Comma-separated Host and Origin allowlists for the MCP transport. Compose supplies
# loopback-only values; a reverse proxy deployment must set its actual public values.
# QUERY_MAN_MCP_ALLOWED_HOSTS=query.example.com
# QUERY_MAN_MCP_ALLOWED_ORIGINS=https://query.example.com
# Bootstrap-only query credential shortcut. It never grants admin capability and managed mode
# rejects it. Required on non-loopback bootstrap when no access-policy file is configured.
# QUERY_MAN_API_TOKEN=replace-with-at-least-32-random-characters
# Version 2 policy for multiple callers and explicit admin capability. Managed mode requires this
# setting with at least one non-admin query identity and one operator admin identity. Version 1 and
# allowed_sources/all_sources fields fail closed.
# QUERY_MAN_ACCESS_POLICY_FILE=config/access-policies.yaml
QUERY_MAN_METADATA_CACHE_TTL_MS=30000
QUERY_MAN_METADATA_MAX_STALE_MS=300000
QUERY_MAN_METADATA_RETRY_DELAY_MS=5000
# Required only in `managed` mode. Give every simultaneously running deployment slot a unique,
# stable lowercase slug (1-80 characters), and reuse that value when the same slot restarts.
# Bootstrap mode ignores this setting, including malformed values.
# QUERY_MAN_REPLICA_ID=query-man-runtime-a
# Required only in `managed` mode together with QUERY_MAN_ACCESS_POLICY_FILE. Local Compose stays
# in `bootstrap` mode and does not provision TLS or the dedicated LOGIN. Apply
# scripts/apply-control-schema.sh and create/grant the LOGIN.
# QUERY_MAN_CONTROL_DSN=host=control-db.example.invalid port=5432 dbname=query_man user=query_man_control password=replace-me sslmode=verify-full
# Required with QUERY_MAN_CONTROL_DSN in `managed` mode for encrypted source generations.
# Generate a unique production value with: openssl rand -base64 32 | tr '+/' '-_'
# Syntax-only local example (32 decoded bytes, padded URL-safe Base64):
# QUERY_MAN_SOURCE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
QUERY_MAN_SOURCE_RELOAD_INTERVAL_MS=5000
QUERY_MAN_SHUTDOWN_GRACE_MS=10000
