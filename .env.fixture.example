# Local/CI fixture only. COMPOSE_FILE adds the disposable PostgreSQL service to the
# application-only base topology. Do not use this file for a deployed service.
COMPOSE_FILE=compose.yaml:compose.fixture.yaml
POSTGRES_DB=query_man
POSTGRES_USER=query_man_admin
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432
QUERY_MAN_POSTGRES_HOST=postgres
TZ=Asia/Seoul
# Compose maps separate query-only and operator caller tokens into the Query Man container.
# Every authenticated caller sees all configured sources. Generate different local
# values for the two tokens with: openssl rand -hex 32
QUERY_MAN_CODEX_MCP_TOKEN=replace-with-at-least-32-random-characters
QUERY_MAN_OPERATOR_TOKEN=replace-with-a-different-32-character-random-token
DEVELOPMENT_ISSUES_READER_PASSWORD=replace-with-a-local-secret
MARKET_VOC_READER_PASSWORD=replace-with-a-local-secret
QUERY_MAN_PORT=3000
# Optional second loopback port used only by the Compose `soak` profile.
QUERY_MAN_REPLICA_PORT=3001
QUERY_MAN_LOG_LEVEL=info
# Optional consent-gated diagnostic capture. All three settings must be provided together.
# Diagnostic capture is not available when the OAuth resource-server mode below is selected.
# The database path must be on a private writable volume outside the repository. Capture records
# use a maximum seven-day TTL and a default 100 MiB/day encrypted-payload ingestion budget.
# Generate a unique key with: openssl rand -base64 32 | tr '+/' '-_'
# QUERY_MAN_DIAGNOSTIC_CAPTURE_DATABASE=/var/lib/query-man/diagnostics/capture.sqlite3
# QUERY_MAN_DIAGNOSTIC_CAPTURE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# QUERY_MAN_DIAGNOSTIC_CAPTURE_KEY_ID=capture-key-2026-08
# QUERY_MAN_DIAGNOSTIC_CAPTURE_DAILY_BYTES=104857600
# Source authority is the Git-reviewed YAML under config/. Runtime rejects retired alternate
# authority settings instead of silently falling back to these files.
# Comma-separated Host and Origin allowlists for the MCP transport. Compose supplies
# loopback-only values; a reverse proxy deployment must set its actual public values.
# QUERY_MAN_MCP_ALLOWED_HOSTS=query.example.com
# QUERY_MAN_MCP_ALLOWED_ORIGINS=https://query.example.com
# Query credential shortcut. It never grants operator capability. Required on non-loopback
# deployments when no access-policy file or OAuth resource-server settings are configured.
# QUERY_MAN_API_TOKEN=replace-with-at-least-32-random-characters
# Version 2 policy for multiple callers and explicit operator capability. Version 1 and
# allowed_sources/all_sources fields fail closed.
# QUERY_MAN_ACCESS_POLICY_FILE=config/access-policies.yaml
# AuthBridge OAuth resource-server alternative. Configure all five required values together and do
# not combine them with QUERY_MAN_API_TOKEN or QUERY_MAN_ACCESS_POLICY_FILE. Query Man validates JWT
# access tokens locally and does not need a client secret or handle refresh tokens.
# QUERY_MAN_OAUTH_ISSUER=https://smart-dna.sec.samsung.net/ws2/30001/realms/authbridge
# QUERY_MAN_OAUTH_AUDIENCE=query-man
# QUERY_MAN_OAUTH_QUERY_SCOPES=query-man.read
# QUERY_MAN_OAUTH_MCP_SCOPES=mcp.tools
# QUERY_MAN_OAUTH_OPERATOR_SCOPES=query-man.admin
# Optional comma-separated exact realm roles/groups.
# QUERY_MAN_OAUTH_QUERY_ROLES=query-analyst
# QUERY_MAN_OAUTH_QUERY_GROUPS=/query-users
# QUERY_MAN_OAUTH_OPERATOR_ROLES=query-operator
# QUERY_MAN_OAUTH_OPERATOR_GROUPS=/query-admins
QUERY_MAN_METADATA_CACHE_TTL_MS=30000
QUERY_MAN_METADATA_MAX_STALE_MS=300000
QUERY_MAN_METADATA_RETRY_DELAY_MS=5000
# One shared graceful-work budget; the orchestrator stop grace must leave cleanup overhead.
QUERY_MAN_SHUTDOWN_GRACE_MS=10000
